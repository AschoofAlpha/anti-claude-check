{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "version": { "type": "string" },
    "browser_env": { "type": "string" },
    "timestamp": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "category": { "type": "string" },
          "status": { "enum": ["pass", "fail", "warning", "skipped", "unknown"] },
          "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
          "confidence": { "enum": ["confirmed", "high", "possible", "unknown"] },
          "explanation": { "type": "string" },
          "evidence": { "type": "array" }
        },
        "required": ["id", "title", "category", "status", "severity", "confidence"]
      }
    }
  },
  "required": ["version", "timestamp", "findings"]
}
